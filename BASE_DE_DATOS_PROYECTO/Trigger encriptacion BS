
// Trigger para encriptar contraseña para un nuevo usuario 

DELIMITER $$

CREATE TRIGGER trg_encriptar_contrasena
BEFORE INSERT ON usuario
FOR EACH ROW
BEGIN
    SET NEW.contrasena = SHA2(NEW.contrasena, 256);
END$$

DELIMITER ;


// trigger para encriptar nueva contraseña para usuario existente 

DELIMITER $$

CREATE TRIGGER trg_encriptar_contrasena_update
BEFORE UPDATE ON usuario
FOR EACH ROW
BEGIN
    IF NEW.contrasena <> OLD.contrasena THEN
        SET NEW.contrasena = SHA2(NEW.contrasena, 256);
    END IF;
END$$

DELIMITER ;
